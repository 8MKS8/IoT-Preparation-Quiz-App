<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_purple">#818CF8</color>
    <color name="background_dark">#0F172A</color>
    <color name="card_background">#1E293B</color>
    <color name="correct_green">#15803D</color>
    <color name="option_default">#1E293B</color>
    <color name="option_disabled">#334155</color>
    <color name="primary_blue">#38BDF8</color>
    <color name="text_primary">#F1F5F9</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="wrong_red">#B91C1C</color>
    <string name="app_name">Quiz App</string>
    <style name="QuizActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/card_background</item>
        <item name="titleTextStyle">@style/QuizActionBarTitle</item>
    </style>
    <style name="QuizActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Theme.QuizApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="actionBarStyle">@style/QuizActionBar</item>
    </style>
</resources>